{
  "nodes": {
    "data-access": {
      "name": "data-access",
      "type": "lib",
      "data": {
        "root": "libs/data-access",
        "targets": {
          "build": {
            "executor": "@nx/js:tsc",
            "dependsOn": [
              "^build"
            ],
            "outputs": [
              "{projectRoot}/dist"
            ],
            "options": {
              "outputPath": "dist/libs/data-access",
              "tsConfig": "libs/data-access/tsconfig.lib.json",
              "main": "libs/data-access/src/index.ts"
            },
            "configurations": {}
          }
        },
        "name": "data-access",
        "$schema": "../../node_modules/nx/schemas/project-schema.json",
        "projectType": "library",
        "sourceRoot": "libs/data-access/src",
        "tags": [
          "scope:shared",
          "type:data"
        ],
        "implicitDependencies": []
      }
    },
    "portal": {
      "name": "portal",
      "type": "app",
      "data": {
        "root": "apps/portal",
        "targets": {
          "build": {
            "executor": "@nx/vite:build",
            "dependsOn": [
              "^build"
            ],
            "outputs": [
              "{options.outputPath}"
            ],
            "options": {
              "configFile": "apps/portal/vite.config.ts",
              "outputPath": "dist/apps/portal",
              "tsConfig": "apps/portal/tsconfig.app.json",
              "skipTypeCheck": true
            },
            "configurations": {}
          },
          "lint": {
            "executor": "@nx/eslint:lint",
            "inputs": [
              "default",
              "{workspaceRoot}/.eslintrc.json"
            ],
            "options": {
              "lintFilePatterns": [
                "apps/portal/**/*.ts",
                "apps/portal/**/*.html"
              ]
            },
            "configurations": {}
          },
          "test": {
            "executor": "@nx/jest:jest",
            "inputs": [
              "default",
              "{workspaceRoot}/jest.preset.js",
              "{workspaceRoot}/tsconfig.base.json"
            ],
            "outputs": [
              "{workspaceRoot}/coverage/{projectRoot}"
            ],
            "options": {
              "jestConfig": "apps/portal/jest.config.ts",
              "passWithNoTests": true
            },
            "configurations": {}
          },
          "serve": {
            "executor": "@nx/vite:dev-server",
            "options": {
              "buildTarget": "portal:build"
            },
            "configurations": {}
          }
        },
        "projectType": "application",
        "sourceRoot": "apps/portal/src",
        "prefix": "app",
        "name": "portal",
        "$schema": "../../node_modules/nx/schemas/project-schema.json",
        "tags": [
          "scope:portal",
          "type:app"
        ],
        "implicitDependencies": []
      }
    },
    "state": {
      "name": "state",
      "type": "lib",
      "data": {
        "root": "libs/state",
        "targets": {
          "build": {
            "executor": "@nx/js:tsc",
            "dependsOn": [
              "^build"
            ],
            "outputs": [
              "{projectRoot}/dist"
            ],
            "options": {
              "outputPath": "dist/libs/state",
              "tsConfig": "libs/state/tsconfig.lib.json",
              "main": "libs/state/src/index.ts"
            },
            "configurations": {}
          }
        },
        "name": "state",
        "$schema": "../../node_modules/nx/schemas/project-schema.json",
        "projectType": "library",
        "sourceRoot": "libs/state/src",
        "tags": [
          "scope:shared",
          "type:state"
        ],
        "implicitDependencies": []
      }
    },
    "ui": {
      "name": "ui",
      "type": "lib",
      "data": {
        "root": "libs/ui",
        "targets": {
          "build": {
            "executor": "@nx/js:tsc",
            "dependsOn": [
              "^build"
            ],
            "outputs": [
              "{projectRoot}/dist"
            ],
            "options": {
              "outputPath": "dist/libs/ui",
              "tsConfig": "libs/ui/tsconfig.lib.json",
              "main": "libs/ui/src/index.ts"
            },
            "configurations": {}
          },
          "lint": {
            "executor": "@nx/eslint:lint",
            "inputs": [
              "default",
              "{workspaceRoot}/.eslintrc.json"
            ],
            "options": {
              "lintFilePatterns": [
                "libs/ui/**/*.ts",
                "libs/ui/**/*.html"
              ]
            },
            "configurations": {}
          },
          "test": {
            "executor": "@nx/vite:test",
            "inputs": [
              "default",
              "{workspaceRoot}/jest.preset.js",
              "{workspaceRoot}/tsconfig.base.json"
            ],
            "options": {
              "configFile": "libs/ui/vite.config.ts",
              "passWithNoTests": true
            },
            "configurations": {}
          }
        },
        "name": "ui",
        "$schema": "../../node_modules/nx/schemas/project-schema.json",
        "projectType": "library",
        "sourceRoot": "libs/ui/src",
        "tags": [
          "scope:shared",
          "type:ui"
        ],
        "implicitDependencies": []
      }
    }
  },
  "externalNodes": {},
  "dependencies": {
    "data-access": [],
    "portal": [
      {
        "source": "portal",
        "target": "data-access",
        "type": "static"
      },
      {
        "source": "portal",
        "target": "ui",
        "type": "static"
      }
    ],
    "state": [],
    "ui": []
  },
  "version": "6.0"
}
