  "form_endpoints": {
    "description": "Standard CRUD endpoints for all MCA forms. Each form has the same endpoint pattern.",
    "forms": [
      "adt1", "ben2", "pas3", "dpt3", "aoc4", "aoc4cfs", "mgt7a", "msme", "msme1", "ndh1", "ndh2",
      "boardreport", "charge", "chg1", "chg4", "chg6", "chg8", "chg9",
      "dir3", "dir5", "dir6", "dir9", "dir11", "dir12", "dpt4",
      "form3", "form4", "form5", "form11", "form12", "form15", "form22", "form23", "form24", "form28",
      "gnl1", "gnl2", "gnl3", "iepf2", "iepf5",
      "inc4", "inc12", "inc20a", "inc22", "inc23", "inc24", "inc28",
      "mgt6", "mgt8", "mgt9", "mgt14", "mr1", "msc3",
      "pas2", "pas6", "run", "runllp", "sh7", "sh8", "sh9", "sh11", "stk2"
    ],
    "endpoint_patterns": [
      {
        "method": "GET",
        "path": "/forms/{form_code}",
        "roles": ["user", "admin", "viewer", "manager"],
        "description": "List all submissions for form"
      },
      {
        "method": "POST",
        "path": "/forms/{form_code}",
        "roles": ["user", "admin", "manager"],
        "description": "Create new form submission"
      },
      {
        "method": "GET",
        "path": "/forms/{form_code}/{id}",
        "roles": ["user", "admin", "viewer", "manager"],
        "description": "Get form submission by ID"
      },
      {
        "method": "PUT",
        "path": "/forms/{form_code}/{id}",
        "roles": ["user", "admin", "manager"],
        "description": "Update form submission"
      },
      {
        "method": "DELETE",
        "path": "/forms/{form_code}/{id}",
        "roles": ["admin"],
        "description": "Delete form submission - admin only"
      },
      {
        "method": "GET",
        "path": "/forms/{form_code}/company/{company_id}",
        "roles": ["user", "admin", "viewer", "manager"],
        "description": "Get form submissions by company ID"
      },
      {
        "method": "PATCH",
        "path": "/forms/{form_code}/{id}/status/{status}",
        "roles": ["admin"],
        "description": "Update form submission status - admin only"
      }
    ]
  },
  "notes": [
    "All endpoints require authentication unless marked as 'public'",
    "Admin role has full access to all endpoints",
    "User role has read and write access to most endpoints except admin-only operations",
    "Viewer role has read-only access",
    "Manager role has read and write access to assigned resources",
    "Form endpoints follow a consistent pattern across all 51+ MCA forms",
    "DELETE operations are typically restricted to admin only",
    "Status updates are typically restricted to admin only"
  ]
